# Copy to .env or let ./setup.sh prompt. Never commit .env.
# The gateway also reads ~/.config/conduit/.env at runtime.
ZAI_API_KEY=
# Optional terminal failover tier (Anthropic → GLM → DeepSeek).
# Leave empty to disable the DeepSeek tier.
DEEPSEEK_API_KEY=
# Optional; enables Jev routing mode (per-call model choice via TypeSafe System One).
TYPESAFE_API_KEY=
