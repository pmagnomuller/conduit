<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pedro.conduit</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/conduit</string>
		<string>-config</string>
		<string>@HOME@/.config/conduit/config.toml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>@HOME@/.local/state/conduit</string>
	<key>StandardOutPath</key>
	<string>@HOME@/.local/state/conduit/gateway.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.local/state/conduit/gateway.log</string>
</dict>
</plist>
